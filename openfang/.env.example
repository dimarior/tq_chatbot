# ─────────────────────────────────────────────────────────────────────────────
# OpenFang — variables de entorno (Módulo 3, Ruta B)
# Copia a openfang/.env y rellena. NUNCA commitees openfang/.env (gitignored).
# Carga estas variables en la shell donde corras `openfang start` y el gateway.
#   set -a; source openfang/.env; set +a
# ─────────────────────────────────────────────────────────────────────────────

# Token del bot de Telegram (créalo con @BotFather → /newbot → copia el token).
TELEGRAM_BOT_TOKEN=

# Gateway QR de WhatsApp (modo "web"). OpenFang se conecta a esta URL para
# enrutar los mensajes. El gateway corre en el puerto 3009 (ver `make of-whatsapp`).
WHATSAPP_WEB_GATEWAY_URL=http://127.0.0.1:3009

# Ruta ABSOLUTA al clon del repo fuente de OpenFang (sólo para el gateway de
# WhatsApp, que vive en packages/whatsapp-gateway y NO viene en el binario).
#   git clone https://github.com/RightNow-AI/openfang ~/develop/openfang
# Déjalo comentado para usar el default del Makefile ($HOME/develop/openfang),
# o ponlo con ruta absoluta (sin '~'):
# OPENFANG_SRC=/Users/jacob/develop/openfang

# Ollama corre nativo en el host; sin API key. Cambia sólo si usas otro host/puerto.
OLLAMA_HOST=http://localhost:11434

# URL del API de OpenFang (la usa el gateway de WhatsApp y el script de migración).
OPENFANG_URL=http://127.0.0.1:4200
